# Server Configuration
PORT=5000
NODE_ENV=production

# Authentication (Minimum 32 random characters in production)
JWT_SECRET=your-secure-random-jwt-secret-here-min-32-chars

# Initial Production Administrator / Manager Account
# (Provisioned cleanly if database is empty - 0 dummy trips/fleet created)
INITIAL_ADMIN_EMAIL=manager@company.com
INITIAL_ADMIN_PASSWORD=change-me-to-a-secure-production-password
AUTO_SEED=false

# Storage Paths (Use persistent mount in container environments)
DATA_DIR=./data
UPLOADS_DIR=./uploads/photos

# ==============================================================================
# SAP ONE Portal ERP Integration (Enterprise Fleet Ledger)
# ==============================================================================
SAP_ONE_PORTAL_URL=https://oneportal.company.internal/api/v1
SAP_ONE_COMPANY_DB=HOSEXPERTS_LIVE
SAP_ONE_USERNAME=b1_dispatcher_service
SAP_ONE_PASSWORD=your-sap-service-layer-password
SAP_ONE_SYNC_ENABLED=true
